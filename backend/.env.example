# Server
PORT=3003

# CORS - the URL of the deployed/running frontend
FRONTEND_URL=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ticket_db

# Set to "true" for local development to auto-create tables from entities.
# In a real production deployment, use TypeORM migrations instead and set this to "false".
DB_SYNCHRONIZE=true
